# Copy to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
BASE_URL=http://localhost:5000
# Frontend URL, used for links in emails (e.g. password reset)
APP_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (leave empty to disallow cross-origin requests)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting)
TRUST_PROXY=0

MONGO_URI=mongodb://localhost:27017/holoapp
# Optional: share rate-limit counters across instances
REDIS_URL=

# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=1h
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=7d

# Email (password reset). Without SMTP_HOST, emails are logged in development only.
MAIL_FROM="HoloApp <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Passkeys (WebAuthn). RP ID is the frontend's domain, without scheme or port.
WEBAUTHN_RP_NAME=HoloApp
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173

# Holobot (OpenAI-compatible chat completions API)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o
AI_TIMEOUT_MS=30000
HOLOBOT_DAILY_LIMIT=50

# Error tracking (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Used by `npm run seed` to create or promote the first admin (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=
