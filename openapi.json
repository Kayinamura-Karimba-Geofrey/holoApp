{
  "openapi": "3.0.3",
  "info": {
    "title": "HoloApp API",
    "version": "1.0.0",
    "description": "Comprehensive API documentation for HoloApp"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Local" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AuthRegisterRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 },
          "fingerprintId": { "type": "string" }
        }
      },
      "AuthLoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "AuthTokens": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": { "email": { "type": "string", "format": "email" } }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["token", "newPassword"],
        "properties": {
          "token": { "type": "string" },
          "newPassword": { "type": "string", "minLength": 6 }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": { "refreshToken": { "type": "string" } }
      },
      "HolobotChatRequest": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "context": { "type": "string" }
        }
      },
      "HelpArticle": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "createdBy": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "HelpArticleCreate": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" }
        }
      },
      "SettingsUpdate": {
        "type": "object",
        "properties": {
          "maintenanceMode": { "type": "boolean" },
          "version": { "type": "string" }
        }
      },
      "ThemeUpdate": {
        "type": "string",
        "enum": ["dark", "light", "neon", "glass"]
      },
      "VRDevice": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "status": { "type": "string" },
          "ipAddress": { "type": "string" }
        }
      }
    }
  },
  "security": [],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthRegisterRequest" } } }
        },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthLoginRequest" } } } },
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthTokens" } } } } }
      }
    },
    "/auth/fingerprint": {
      "post": {
        "summary": "Login via fingerprint",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "fingerprintId": { "type": "string" } }, "required": ["fingerprintId"] } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/logout": {
      "post": { "summary": "Logout", "responses": { "200": { "description": "OK" } } }
    },
    "/auth/forgot-password": {
      "post": { "summary": "Request password reset", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForgotPasswordRequest" } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/auth/reset-password": {
      "post": { "summary": "Reset password", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/auth/refresh-token": {
      "post": { "summary": "Refresh access token", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" } } } }, "responses": { "200": { "description": "OK" } } }
    },

    "/holobot/chat": {
      "post": {
        "summary": "Send a chat message",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HolobotChatRequest" } } } },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/holobot/history": {
      "get": { "summary": "Get chat history", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/holobot/clear": {
      "delete": { "summary": "Clear chat history", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/holobot/settings": {
      "get": { "summary": "Get AI settings", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } },
      "put": { "summary": "Update AI settings", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "OK" } } }
    },

    "/help/articles": {
      "get": { "summary": "List help articles", "responses": { "200": { "description": "OK" } } },
      "post": { "summary": "Create help article", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HelpArticleCreate" } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/help/{id}": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
      "get": { "summary": "Get article by id", "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HelpArticle" } } } } } },
      "put": { "summary": "Update article", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HelpArticleCreate" } } } }, "responses": { "200": { "description": "OK" } } },
      "delete": { "summary": "Delete article", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },

    "/operations/stats": {
      "get": { "summary": "Get statistics", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/operations/system-status": {
      "get": { "summary": "Get system status", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/operations/logs": {
      "get": { "summary": "List system logs", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } },
      "delete": { "summary": "Clear system logs", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },

    "/vr/devices": {
      "get": { "summary": "List VR devices", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/vr/config": {
      "post": { "summary": "Send VR config", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/vr/scenes": {
      "get": { "summary": "List VR scenes", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },
    "/vr/scenes/{id}": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } } ],
      "get": { "summary": "Get scene by id", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } }
    },

    "/settings/system": {
      "get": { "summary": "Get system settings", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } },
      "put": { "summary": "Update system settings", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SettingsUpdate" } } } }, "responses": { "200": { "description": "OK" } } }
    },
    "/settings/theme": {
      "get": { "summary": "Get available themes", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "OK" } } },
      "put": { "summary": "Update theme", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ThemeUpdate" } } } }, "responses": { "200": { "description": "OK" } } }
    }
  }
}


